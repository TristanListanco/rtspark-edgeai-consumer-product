  },
  "frameworks": [
    "cmsis",
    "stm32cube"
  ],
  "name": "RT-Thread RT-Spark (Spark-1, STM32F407ZGT6)",
  "upload": {
    "maximum_ram_size": 131072,
    "maximum_size": 1048576,
    "protocol": "stlink",
    "protocols": [
      "stlink",
      "cmsis-dap",
      "jlink"
    ]
  },
