{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m4",
    "extra_flags": "-DSTM32F4 -DSTM32F407xx",
    "f_cpu": "168000000L",
    "mcu": "stm32f407zgt6",
    "product_line": "STM32F407xx"
  },
  "connectivity": [
    "can"
  ],
  "debug": {
    "jlink_device": "STM32F407ZG",
    "openocd_target": "stm32f4x",
